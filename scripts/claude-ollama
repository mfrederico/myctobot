#!/bin/bash
#
# claude-ollama - Run Claude Code CLI with local Ollama models
#
# Ollama natively supports Anthropic API format, so no proxy is needed!
#
# Usage:
#   claude-ollama                    # Start with default model (qwen3-coder:30b)
#   claude-ollama --model MODEL      # Start with specific model
#   claude-ollama --models           # List available Ollama models
#

set -e

OLLAMA_URL="http://localhost:11434"
DEFAULT_MODEL="qwen3-coder:30b"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Check if Ollama is running
check_ollama() {
    if ! curl -s "$OLLAMA_URL/api/tags" > /dev/null 2>&1; then
        log_error "Ollama is not running on $OLLAMA_URL"
        log_info "Start it with: ollama serve"
        exit 1
    fi
}

# Check if model is available
check_model() {
    local model="$1"
    if ! ollama list 2>/dev/null | grep -q "^${model}"; then
        log_warn "Model '$model' not found in Ollama"
        log_info "Available models:"
        ollama list 2>/dev/null | head -10
        echo ""
        log_info "Pull it with: ollama pull $model"
        exit 1
    fi
}

# Show usage
usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo ""
    echo "Run Claude Code CLI with local Ollama models"
    echo ""
    echo "Options:"
    echo "  --model MODEL    Use specific Ollama model (default: $DEFAULT_MODEL)"
    echo "  --models         List available Ollama models"
    echo "  -h, --help       Show this help"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0")                        # Start with qwen3-coder:30b"
    echo "  $(basename "$0") --model devstral:latest"
    echo ""
    echo "Environment (set by this script):"
    echo "  ANTHROPIC_BASE_URL=$OLLAMA_URL"
    echo "  ANTHROPIC_API_KEY=ollama"
    echo ""
    echo "Note: Ollama natively supports Anthropic API format with tool calling."
    echo "Some internal Claude CLI requests may show 404 errors (model name lookups)"
    echo "but tool calling works correctly."
}

# Main
main() {
    local model="$DEFAULT_MODEL"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model)
                model="$2"
                shift 2
                ;;
            --models)
                ollama list
                exit 0
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done

    # Pre-flight checks
    check_ollama
    check_model "$model"

    # Launch Claude Code directly with Ollama
    log_info "Launching Claude Code with Ollama model: $model"
    echo ""

    export ANTHROPIC_BASE_URL="$OLLAMA_URL"
    export ANTHROPIC_API_KEY="ollama"

    exec claude --model "$model"
}

main "$@"
